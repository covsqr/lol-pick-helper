{
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/meta",
      "dest": "/api/meta.js"
    },
    {
      "src": "/api/champion",
      "dest": "/api/champion.js"
    },
    {
      "src": "/api/matchup",
      "dest": "/api/matchup.js"
    },
    {
      "src": "/api/riot-connect",
      "dest": "/api/riot-connect.js"
    },
    {
      "src": "/api/supabase-rpc",
      "dest": "/api/supabase-rpc.js"
    },
    {
      "src": "/favicon.png",
      "dest": "/public/favicon.png"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.png"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
